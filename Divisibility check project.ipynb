    "Inputed_Number = int(input(\" Enter a number, specifically an integer :  \"))\n",
    "def Divisibility_Checker(x):\n",
    "    if x % 5 == 0:\n",
    "        return(\"Your number is divisible by 5.\")\n",
    "    else:\n",
    "        return(\"Your number is not divisible by 5.\")\n",
    "print(Divisibility_Checker(Inputed_Number))"
   ]
